{
  "name": "orbit-chat",
  "productName": "Orbit",
  "version": "1.1.1",
  "description": "App de desktop para conversas, chamadas de voz e compartilhamento de tela",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server/start.js",
    "dist": "electron-builder --win nsis"
  },
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "electron-updater": "^6.8.9",
    "express": "^4.19.2",
    "mongodb": "^7.6.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.orbit.chat",
    "productName": "Orbit",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server/**/*",
      "shared/**/*",
      "renderer/**/*",
      "!data/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Orbit",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AlvesBernardo626",
        "repo": "orbit-chat-app"
      }
    ]
  }
}
